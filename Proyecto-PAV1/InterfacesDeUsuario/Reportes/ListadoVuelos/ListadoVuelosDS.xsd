                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT V.IdVuelo, V.NroVuelo, CO.Nombre AS 'CiudadOrigen', AO.CodigoAeropuerto AS 'CodAeropuertoOrigen', CD.Nombre AS 'CiudadDestino', AD.CodigoAeropuerto AS 'CodAeropuertoDestino', V.FechaPartida, CONVERT(varchar(5), 
                  D.HorarioPartida, 108) AS 'HorarioPartida', CONVERT(varchar(5), D.HorarioLlegada, 108) AS 'HorarioLlegada', CONVERT(varchar(5), D.HorarioEmbarque, 108) AS 'HorarioEmbarque', CONVERT(varchar(5), 
                  D.HorarioLlegada - D.HorarioPartida, 108) AS 'Duracion'
FROM     VUELO AS V INNER JOIN
                  DEFINICION_DE_VUELO AS D ON V.NroVuelo = D.NroVuelo INNER JOIN
                  CAMBIO_ESTADO_VUELO AS CV ON V.IdVuelo = CV.IdVuelo INNER JOIN
                  AEROPUERTO AS AO ON D.CodigoAeropuertoOrigen = AO.CodigoAeropuerto INNER JOIN
                  AEROPUERTO AS AD ON D.CodigoAeropuertoDestino = AD.CodigoAeropuerto INNER JOIN
                  CIUDAD AS CO ON AO.CodigoCiudad = CO.CodigoCiudad INNER JOIN
                  CIUDAD AS CD ON AD.CodigoCiudad = CD.CodigoCiudad
WHERE  (CV.IdEstadoVuelo = 1) AND
                      ((SELECT COUNT(*) AS Expr1
                        FROM      ASIENTO AS A
                        WHERE   (Estado = 1) AND (IdVuelo = V.IdVuelo)) &lt;
                      (SELECT (FilasPC * AsientosPC + FilasCB * AsientosCB) + FilasCT * FilasCT AS Expr1
                       FROM      AVION AS A
                       WHERE   (Matricula = D.MatriculaAvion)))</CommandText>
                    <Parameters />
                  </DbCommand>
                </SelectCommand>
              </DbSource>
